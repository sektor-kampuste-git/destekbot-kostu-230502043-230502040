# .env olarak kopyalayın:  cp .env.example .env
# .env dosyası .gitignore'dadır; ASLA commit etmeyin.

# --- Sohbet modeli (OpenAI uyumlu; bloklardan BİRİNİ açın) ---
# (a) Gemini ücretsiz katman
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=BURAYA_GEMINI_ANAHTARI
LLM_MODEL=gemini-3.5-flash-lite

# (b) OpenRouter — hocanın verdiği takım anahtarı
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=HOCANIN_VERDIGI_ANAHTAR
# LLM_MODEL=openai/gpt-6-luna

# (c) Ollama — yerel, ücretsiz
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.5:4b

# --- Gömme modeli (RAG) — boşsa LLM_* kullanılır ---
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001

# --- Veritabanı (Supabase) — boşsa yerel SQLite kullanılır ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Ajan bütçesi ve durma koşulları (SPEC K8) ---
MAKS_ADIM=5
BUTCE_USD_ISTEK=0.01
ZAMAN_ASIMI_SN=20

# --- Eval'ler için sabit tarih (SPEC K6); boşsa bugünün tarihi ---
SIMULASYON_TARIHI=2026-11-05

# --- İzleme (opsiyonel, Langfuse ücretsiz katman) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Temsilci paneli koruması: canlıda MUTLAKA doldurun (boşsa panel herkese açık) ---
PANEL_ANAHTARI=

# --- Hibrit RAG: 1 yapılırsa BM25'e ek olarak gömme araması (EMBED_* kullanılır) ---
RAG_GOMME=0

# --- Eval hakemi (boşsa LLM_* kullanılır) ---
HAKEM_MODEL=
